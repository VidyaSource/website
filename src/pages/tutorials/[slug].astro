---
import Page from '../../components/Page.astro'
import {tutorials} from '../../layouts/tutorials/tutorialUtils';
import Tutorial from "../../layouts/tutorials/Tutorial.astro";

export const prerender = true;
export async function getStaticPaths() {
    return Promise.all(tutorials.map(async (t) => {
        return {
            params: {slug: t.slug},
            props: t,
        };
    }));
}
const {
    title, description, image, youtube, openGraph
} = Astro.props

// Google's video rich results need a top-level @context and the page URL. Copy the shared
// schema so the ItemList on the index page never sees these page-specific fields.
const schema = {
    "@context": "https://schema.org",
    ...Astro.props.schema,
    url: Astro.url.href,
    image: `${Astro.url.origin}${image}`
}
---
<Page title={`${title} | Vidya`}
      description={description}
      image={image}
      schema={schema}
      twitterCard="player"
      openGraph={openGraph}
      meta={[
          {name: "twitter:player", content: `https://www.youtube.com/embed/${youtube}`},
          {name: "twitter:player:width", content: "1280"},
          {name: "twitter:player:height", content: "720"},
          {name: "twitter:image", content: `${Astro.url.origin}${image}`},
          {name: "twitter:image:alt", content: description}
      ]}>
    <Tutorial {...Astro.props}/>
</Page>