---
import Home from '../layouts/home/Home.astro';
import {ClientRouter} from 'astro:transitions';
import VidyaSEO from "../components/VidyaSEO.astro"
import vidyaSchema from '../components/vidyaSchema.json'
import Analytics from "../components/Analytics.astro";
import TailwindElements from "../components/TailwindElements.astro";
import MachineReadable from "../components/MachineReadable.astro";
---
<html lang="en">
<head>
    <Analytics />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <!-- VidyaSEO below owns the meta description. Do not add one here: it emits a
         second, competing description tag ahead of the real one. -->
    <meta name="viewport" content="width=device-width"/>
    <MachineReadable />
    <meta name="generator" content={Astro.generator}/>
    <ClientRouter/>
    <VidyaSEO title="Legacy System Modernization & AI Engineering | Vidya"
              description="Vidya modernizes legacy systems with cloud, enterprise AI, and data engineering for business and government. Ship continuously without sacrificing quality."
              schema={vidyaSchema}
    />
    <TailwindElements />
</head>
<body>
<Home/>
</body>
</html>
