---
import Page from '../../src/components/Page.astro'
import "../globals.css"
---
<Page title="Page Not Found | Vidya"
      description="Oops! The page you're looking for doesn't exist. Visit Vidya's website for legacy system modernization, IT consulting, and technology training."
      noindex={true} nofollow={true}>
    <div class="min-h-screen bg-cover bg-top sm:bg-top"
         style={{
             backgroundImage:
                 'url("https://images.unsplash.com/photo-1623598018342-0a5f10b1d376?ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&ixlib=rb-1.2.1&auto=format&fit=crop&w=3300&q=80")',
         }}
    >
        <div class="max-w-7xl mx-auto px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8 lg:py-48">
            {/* The text sits on a photograph, so it gets its own opaque surface. Contrast
                then holds whatever part of the photo is behind it, in both modes. */}
            <div class="inline-block max-w-2xl rounded-2xl bg-blue-light/95 dark:bg-gray-dark/95 px-8 py-10 shadow-xl">
            <p class="text-sm font-semibold text-gray-dark dark:text-gray-light uppercase tracking-wide">
                404 error</p>
            <h1 class="mt-2 text-4xl font-extrabold text-red dark:text-red-light tracking-tight sm:text-5xl">
                Uh oh! I think you’re lost.
            </h1>
            <p class="mt-2 text-lg font-medium text-gray-dark dark:text-blue-light">
                It looks like the page you’re looking for doesn't exist.
            </p>
            <div class="mt-6">
                <a href="/"
                   class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red hover:bg-blue-dark">
                    Go back home
                </a>
            </div>
            </div>
        </div>
    </div>
</Page>