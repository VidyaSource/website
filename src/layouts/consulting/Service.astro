---
import {Image} from 'astro:assets';
import {images} from '../../components/Images';
import CallToAction from '../../components/CallToAction.astro';
import Insights from './Insights.astro';
import {caseStudiesForService} from '../case-studies/caseStudyUtils';

const {
    slug, title, tagline, image, tags, faqs, render
} = Astro.props
const {Content} = await render();
// Case studies opt in through their `services` list, so proof stays next to the claim it supports.
const proof = caseStudiesForService(slug);
---
<article class="relative overflow-hidden bg-blue-light dark:bg-gray-dark">
    <!-- Hero image banner -->
    <div class="relative w-full h-64 sm:h-80 md:h-96 overflow-hidden">
        <Image
            alt={title}
            src={images[`/src${image}`]()}
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-blue-light dark:from-gray-dark to-transparent"></div>
    </div>

    <div class="relative px-4 sm:px-6 lg:px-8 -mt-16 z-10">
        <!-- Header section -->
        <header class="max-w-prose lg:max-w-4xl mx-auto text-center mb-8">
            <span class="inline-block px-4 py-1.5 text-xs font-semibold tracking-widest uppercase rounded-full bg-blue text-white mb-6">
                Vidya Consulting
            </span>

            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-red dark:text-red-light leading-tight mt-0 mb-4">
                {title}
            </h1>

            <p class="text-lg text-gray-dark dark:text-blue-light font-medium max-w-2xl mx-auto">
                {tagline}
            </p>

            <!-- Decorative divider -->
            <div class="mt-8 flex items-center justify-center">
                <div class="w-16 h-1 rounded-full bg-red dark:bg-red-light"></div>
            </div>
        </header>

        <!-- Body prose -->
        <section class="max-w-prose lg:max-w-4xl mx-auto pb-12">
            <div class="text-lg text-gray-dark dark:text-blue-light leading-relaxed">
                <Content/>
            </div>
        </section>

        <!-- Case studies that name this service. Each one links back to this page. -->
        {proof.length > 0 && (
            <section class="max-w-prose lg:max-w-4xl mx-auto pb-16">
                <h2 class="text-2xl font-extrabold tracking-tight text-red dark:text-red-light mb-6 mt-0">
                    Case Studies
                </h2>
                <ul class="grid gap-6 sm:grid-cols-2 list-none pl-0">
                    {proof.map((cs) => (
                        <li class="my-0 not-italic">
                            <a href={`/case-studies/${cs.slug}/`}
                               class="group flex h-full flex-col rounded-lg bg-white dark:bg-gray p-6 border-l-4 border-red dark:border-red-light shadow-sm hover:shadow-lg transition-shadow duration-200 no-underline">
                                <span class="text-xs font-semibold tracking-widest uppercase text-blue dark:text-blue-light">{cs.client}</span>
                                <span class="mt-2 text-lg font-bold text-blue-dark dark:text-white group-hover:text-red dark:group-hover:text-red-light transition-colors duration-200">{cs.title}</span>
                                <span class="mt-3 text-base font-extrabold text-red dark:text-red-light">{cs.outcomes[0].metric}</span>
                                <span class="mt-auto pt-4 text-sm font-semibold text-blue-dark dark:text-blue-light">Read the case study</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )}

        <!-- FAQ -->
        {faqs && faqs.length > 0 && (
            <section class="max-w-prose lg:max-w-4xl mx-auto pb-16">
                <h2 class="text-2xl font-extrabold tracking-tight text-red dark:text-red-light mb-8">
                    Frequently Asked Questions
                </h2>
                <div class="space-y-6">
                    {faqs.map((faq: {question: string, answer: string}) => (
                        <div class="border-b border-gray-light dark:border-gray pb-6">
                            <h3 class="text-lg font-semibold text-blue-dark dark:text-blue mb-2">
                                {faq.question}
                            </h3>
                            <p class="text-gray-dark dark:text-blue-light leading-relaxed">
                                {faq.answer}
                            </p>
                        </div>
                    ))}
                </div>
            </section>
        )}
    </div>
</article>

<Insights topics={tags.map((t: string) => t.toLowerCase())} heading="Related Insights"/>
<CallToAction/>
