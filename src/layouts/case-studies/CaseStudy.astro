---
import {Image} from 'astro:assets';
import {images} from '../../components/Images';
import CallToAction from '../../components/CallToAction.astro';
import RelatedPosts from './RelatedPosts.astro';

const {
    title, client, sector, tagline, image, tags, technologies, outcomes, faqs, excludedPosts, relatedPosts, render
} = Astro.props
const {Content} = await render();
---
<article class="relative overflow-hidden bg-blue-light dark:bg-gray-dark">
    <!-- Hero image banner -->
    <div class="relative w-full h-64 sm:h-80 md:h-96 overflow-hidden">
        <Image
            alt={title}
            src={images[`/src${image}`]()}
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-blue-light dark:from-gray-dark to-transparent"></div>
    </div>

    <div class="relative px-4 sm:px-6 lg:px-8 -mt-16 z-10">
        <!-- Header section -->
        <header class="max-w-prose lg:max-w-4xl mx-auto text-center mb-8">
            <span class="inline-block px-4 py-1.5 text-xs font-semibold tracking-widest uppercase rounded-full bg-blue text-white mb-6">
                Case Study
            </span>

            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-red dark:text-red-light leading-tight mt-0 mb-4">
                {title}
            </h1>

            <p class="text-lg text-gray-dark dark:text-blue-light font-medium max-w-2xl mx-auto">
                {tagline}
            </p>

            <!-- Engagement facts -->
            <dl class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left max-w-2xl mx-auto">
                <div class="rounded-lg bg-white dark:bg-gray p-4">
                    <dt class="text-xs font-semibold tracking-widest uppercase text-blue dark:text-blue-light">Client</dt>
                    <dd class="mt-1 text-base font-semibold text-gray-dark dark:text-blue-light">{client}</dd>
                </div>
                <div class="rounded-lg bg-white dark:bg-gray p-4">
                    <dt class="text-xs font-semibold tracking-widest uppercase text-blue dark:text-blue-light">Sector</dt>
                    <dd class="mt-1 text-base font-semibold text-gray-dark dark:text-blue-light">{sector}</dd>
                </div>
            </dl>

            <!-- Decorative divider -->
            <div class="mt-8 flex items-center justify-center">
                <div class="w-16 h-1 rounded-full bg-red dark:bg-red-light"></div>
            </div>
        </header>

        <!-- Challenge and approach -->
        <section class="max-w-prose lg:max-w-4xl mx-auto pb-12">
            <div class="text-lg text-gray-dark dark:text-blue-light leading-relaxed">
                <Content/>
            </div>
        </section>

        <!-- Primary technologies. Absent on advisory and culture engagements. -->
        {technologies && technologies.length > 0 && (
            <section class="max-w-prose lg:max-w-4xl mx-auto pb-12">
                <h2 class="text-2xl font-extrabold tracking-tight text-red dark:text-red-light mb-6 mt-0">
                    Primary Technologies
                </h2>
                <!-- my-0 and not-italic undo the global `li` rule in globals.css. Do not add
                     pl-0 here: it beats px-4 and collapses the chip's left padding. -->
                <ul class="flex flex-wrap gap-3 list-none pl-0">
                    {technologies.map((t: string) => (
                        <li class="my-0 not-italic whitespace-nowrap rounded-full bg-white dark:bg-gray px-4 py-2 text-sm font-semibold text-blue-dark dark:text-blue-light">
                            {t}
                        </li>
                    ))}
                </ul>
            </section>
        )}

        <!-- Results -->
        <section class="max-w-prose lg:max-w-4xl mx-auto pb-16">
            <h2 class="text-2xl font-extrabold tracking-tight text-red dark:text-red-light mb-6 mt-0">
                Results
            </h2>
            <div class="grid gap-6 sm:grid-cols-2">
                {outcomes.map((o: {metric: string, detail: string}) => (
                    <div class="rounded-lg bg-white dark:bg-gray p-6 border-l-4 border-red dark:border-red-light">
                        <p class="text-xl font-extrabold text-red dark:text-red-light py-0">{o.metric}</p>
                        <p class="mt-2 text-base text-gray-dark dark:text-blue-light leading-relaxed py-0">{o.detail}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- FAQ -->
        {faqs && faqs.length > 0 && (
            <section class="max-w-prose lg:max-w-4xl mx-auto pb-16">
                <h2 class="text-2xl font-extrabold tracking-tight text-red dark:text-red-light mb-8 mt-0">
                    Frequently Asked Questions
                </h2>
                <div class="space-y-6">
                    {faqs.map((faq: {question: string, answer: string}) => (
                        <div class="border-b border-gray-light dark:border-gray pb-6">
                            <h3 class="text-lg font-semibold text-blue-dark dark:text-blue mb-2 mt-0">
                                {faq.question}
                            </h3>
                            <p class="text-gray-dark dark:text-blue-light leading-relaxed">
                                {faq.answer}
                            </p>
                        </div>
                    ))}
                </div>
            </section>
        )}
    </div>
</article>

<RelatedPosts topics={tags}
              technologies={technologies ?? []}
              excluded={excludedPosts ?? []}
              pinned={relatedPosts ?? []}
              heading="Related Insights"/>
<CallToAction/>
