---
import {Image} from 'astro:assets';
import {images} from '../../components/Images';
import {caseStudies} from '../case-studies/caseStudyUtils';

// The first three case studies by their editorial order, each led by its headline
// result. The order field in the case-study front matter decides what appears here.
const featured = caseStudies.slice(0, 3);
---
<section class="relative bg-blue-light dark:bg-blue overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue/20 to-transparent" aria-hidden="true"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-red/5 dark:bg-red-light/5 rounded-full blur-3xl" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:py-24 lg:px-8">
        <div class="sm:flex sm:items-end sm:justify-between">
            <div>
                <p class="text-sm font-semibold tracking-widest uppercase text-green-dark dark:text-green-light mb-3">Case studies</p>
                <h2 class="text-3xl tracking-tight font-extrabold text-red dark:text-red-light sm:text-4xl lg:text-5xl leading-tight">
                    Vidya results you can check.
                </h2>
                <div class="mt-5 h-1 w-16 rounded-full bg-red dark:bg-red-light"></div>
            </div>
            <a href="/case-studies" class="mt-6 sm:mt-0 inline-flex items-center text-base font-semibold text-blue-dark dark:text-blue-light hover:text-red dark:hover:text-red-light transition-colors duration-200">
                All case studies
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
            </a>
        </div>

        <ul role="list" class="mt-12 grid gap-8 lg:grid-cols-3">
            {featured.map((study) => (
                <li class="not-italic pl-0 my-0">
                    <a href={`/case-studies/${study.slug}`}
                       class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white dark:bg-gray-dark shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
                        <div class="h-44 w-full overflow-hidden bg-gray-light">
                            <Image src={images[`/src${study.image}`]()} alt={study.title}
                                   class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"/>
                        </div>
                        <div class="flex flex-1 flex-col p-7">
                            <p class="text-sm font-semibold tracking-widest uppercase text-green-dark dark:text-green-light">{study.client}</p>
                            <p class="mt-3 text-2xl font-extrabold tracking-tight text-red dark:text-red-light">{study.outcomes[0].metric}</p>
                            <h3 class="mt-3 flex-1 text-lg font-bold text-blue-dark dark:text-white group-hover:text-red dark:group-hover:text-red-light transition-colors duration-200">
                                {study.title}
                            </h3>
                            <span class="mt-6 inline-flex items-center text-sm font-semibold text-blue-dark dark:text-blue-light">
                                Read the case study
                                <svg class="ml-1.5 w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                </svg>
                            </span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
