---
import {services} from '../consulting/consultingUtils';
---
{/* A solid brand-blue band so the eye reads a clear break after the pale hero. The
    hero's wave is filled with the same blue, so the two meet at the curve. */}
<section class="relative bg-blue-dark dark:bg-gray-dark overflow-hidden">
    <div class="absolute -top-24 -left-24 w-80 h-80 bg-white/5 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-red-light/10 rounded-full blur-3xl" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:py-24 lg:px-8">
        <div class="lg:grid lg:grid-cols-3 lg:gap-12 lg:items-end">
            <div class="lg:col-span-2">
                <p class="text-sm font-semibold tracking-widest uppercase text-green-light mb-3">What Vidya does</p>
                <h2 class="text-3xl tracking-tight font-extrabold text-white sm:text-4xl lg:text-5xl leading-tight">
                    Six practice areas. One Vidya team has shipped all of them.
                </h2>
                <div class="mt-5 h-1 w-16 rounded-full bg-red-light"></div>
            </div>
            <p class="mt-6 lg:mt-0 text-lg text-blue-light leading-relaxed">
                Every Vidya engagement starts with the system you have and the culture that runs it.
                Pick the practice area closest to your problem.
            </p>
        </div>

        <ul role="list" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((service) => (
                <li class="not-italic pl-0 my-0">
                    <a href={`/consulting/${service.slug}`}
                       class="group flex h-full flex-col rounded-2xl bg-white dark:bg-gray p-7 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
                        <h3 class="text-xl font-bold text-blue-dark dark:text-white group-hover:text-red dark:group-hover:text-red-light transition-colors duration-200">
                            {service.title}
                        </h3>
                        <p class="mt-3 flex-1 text-base text-gray-dark dark:text-blue-light leading-relaxed">
                            {service.tagline}
                        </p>
                        <span class="mt-6 inline-flex items-center text-sm font-semibold text-red dark:text-red-light">
                            Learn more
                            <svg class="ml-1.5 w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                            </svg>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
