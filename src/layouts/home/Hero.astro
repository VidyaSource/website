---
import Logo from "../../components/Logo.astro";
import ThemeButton from "../../components/ThemeButton.astro";
import navigation from "../../components/navigation.json";
import {VIDYA_HEADLINE} from "../../agent/site";
import {proofPoints} from "./proof";
---

{/* The hero is sized to its content. Peers in this field (Ad Hoc, Truss, Skylight)
    keep the first screen short and put proof directly under the headline; the
    three results below do that job here. */}
<div class="relative bg-gradient-to-b from-white via-blue-light to-blue/15 dark:from-blue dark:via-blue-dark dark:to-blue overflow-hidden flex flex-col">
    {/* Skip to main content link - accessibility best practice */}
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue focus:text-white focus:rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-dark"
    >
        Skip to main content
    </a>

    {/* Modern decorative background elements */}
    <div class="hidden sm:block sm:absolute sm:inset-0 sm:overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 max-w-7xl mx-auto">
            {/* Animated gradient orbs - soft, modern aesthetic */}
            <div class="absolute top-20 -left-20 w-72 h-72 bg-red/20 dark:bg-red-light/10 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute top-40 -right-20 w-96 h-96 bg-blue/20 dark:bg-blue-light/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s"></div>
            <div class="absolute bottom-20 left-1/3 w-80 h-80 bg-green/20 dark:bg-green-light/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s"></div>

            {/* Subtle geometric accent shapes */}
            <div class="absolute top-1/4 right-10 w-32 h-32 border border-blue/10 dark:border-blue-light/10 rounded-full"></div>
            <div class="absolute top-1/3 right-20 w-48 h-48 border border-red/10 dark:border-red-light/10 rounded-full"></div>
            <div class="absolute bottom-1/4 left-10 w-40 h-40 border border-green/10 dark:border-green-light/10 rounded-full"></div>

            {/* Floating gradient lines */}
            <div class="absolute top-1/2 left-0 w-1/3 h-px bg-gradient-to-r from-transparent via-blue/20 dark:via-blue-light/20 to-transparent"></div>
            <div class="absolute top-2/3 right-0 w-1/4 h-px bg-gradient-to-l from-transparent via-red/20 dark:via-red-light/20 to-transparent"></div>
        </div>
    </div>

    {/* Header with navigation */}
    <header class="relative pt-6 pb-4 z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav
                class="relative flex items-center justify-between bg-white/60 dark:bg-blue-dark/70 backdrop-blur-md rounded-xl px-4 py-3 shadow-sm ring-1 ring-gray/10 dark:ring-white/10"
                aria-label="Main navigation"
                role="navigation"
            >
                {/* Logo */}
                <div class="flex items-center flex-shrink-0">
                    <a
                        class="logo group focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue rounded-lg transition-transform duration-200 hover:scale-105"
                        href="/"
                        aria-label="Vidya - Go to homepage"
                    >
                        <Logo height="65" width="140" />
                    </a>
                </div>

                {/* Desktop navigation */}
                <div class="hidden md:flex md:items-center md:space-x-1 lg:space-x-2">
                    {navigation.map((item) => (
                        <a
                            data-nav-link
                            href={item.href}
                            class="relative px-4 py-2 text-sm lg:text-base font-semibold rounded-lg transition-all duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue text-blue-dark dark:text-white hover:text-red dark:hover:text-red-light hover:bg-gray-light dark:hover:bg-white/20"
                        >
                            {item.name}
                        </a>
                    ))}
                    <div class="ml-4 pl-4 border-l-2 border-blue/50 dark:border-blue-light/60 flex items-center">
                        <ThemeButton sunFillColor="yellow" moonFillColor="#5A82B4" transition:persist="theme-desktop" />
                    </div>
                </div>

                {/* Mobile menu button */}
                <div class="flex items-center md:hidden space-x-3">
                    <div class="p-1 rounded-lg bg-gray-light/50 dark:bg-white/10">
                        <ThemeButton sunFillColor="yellow" moonFillColor="#5A82B4" transition:persist="theme-mobile" />
                    </div>
                    <button
                        type="button"
                        command="toggle-popover"
                        commandfor="mobile-menu"
                        aria-controls="mobile-menu"
                        aria-label="Open main menu"
                        class="inline-flex items-center justify-center p-2 rounded-lg text-blue-dark dark:text-white bg-gray-light/50 dark:bg-white/10 hover:bg-gray-light dark:hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue transition-colors duration-200"
                    >
                        <span class="sr-only">Open main menu</span>
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
                        </svg>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    {/* Hero content */}
    {/* The bottom padding reserves room for the decorative wave below (h-12/16/20), so
        the content can never sit under it when the hero grows taller than the viewport. */}
    <main id="main-content" class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 pb-20 sm:pb-24">
        <section class="text-center max-w-4xl mx-auto pt-4 sm:pt-6">
            {/* Brand line, headline, one sentence, two actions. The headline is the same
                sentence llms.txt and the page metadata use, so a reader or an agent gets
                the purpose of the site from the H1 alone. */}
            <p class="hero-enter text-base sm:text-lg font-bold tracking-tight" style="animation-delay: 50ms">
                <span class="text-red dark:text-red-light">Build faster.</span>{' '}
                <span class="italic text-gray-dark dark:text-green-light">Build better.</span>
            </p>

            <h1 class="hero-enter mt-4 text-4xl sm:text-5xl md:text-6xl tracking-tight font-extrabold text-blue-dark dark:text-white text-balance" style="animation-delay: 150ms">
                {VIDYA_HEADLINE}
            </h1>

            <p class="hero-enter mt-6 max-w-2xl mx-auto text-lg sm:text-xl text-gray-dark dark:text-blue-light leading-relaxed text-balance" style="animation-delay: 250ms">
                Vidya is a certified small business that helps commercial companies and federal
                agencies modernize what they have and build what comes next.
            </p>

            {/* CTA Buttons */}
            <div class="hero-enter mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6" style="animation-delay: 350ms">
                <a
                    href="/consulting"
                    class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold rounded-xl bg-red dark:bg-red-light text-white dark:text-blue-dark hover:bg-blue-dark dark:hover:bg-blue-light focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl"
                >
                    Partner With Us
                    <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                </a>
                <a
                    href="/courses"
                    class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold rounded-xl bg-white/80 dark:bg-white/10 text-blue-dark dark:text-blue-light border-2 border-blue dark:border-blue-light hover:bg-blue-light dark:hover:bg-blue/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue transform hover:scale-105 transition-all duration-200"
                >
                    Explore Courses
                </a>
            </div>
        </section>

        {/* Proof: three results, each linked to the case study that backs it. The cards
        are opaque with a red top rule, a ring, and a shadow so they read as distinct
        objects against the tinted lower half of the hero rather than blending into it. */}
        <section class="hero-enter w-full max-w-5xl mx-auto mt-10 sm:mt-12" style="animation-delay: 500ms" aria-label="Results Vidya has delivered">
            <ul role="list" class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
                {proofPoints.map((p) => (
                    <li class="not-italic pl-0 my-0">
                        <a href={p.href}
                           class="group flex h-full flex-col rounded-2xl bg-white dark:bg-blue-dark border-t-4 border-red dark:border-red-light px-6 py-5 shadow-lg shadow-blue-dark/15 dark:shadow-gray-dark/60 ring-1 ring-blue/25 dark:ring-white/15 hover:ring-red/50 dark:hover:ring-red-light/50 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 text-left">
                            <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-red dark:text-red-light">{p.value}</p>
                            <p class="mt-2 flex-1 text-base text-gray-dark dark:text-blue-light leading-snug">{p.label}</p>
                            <p class="mt-4 text-xs font-semibold tracking-widest uppercase text-blue dark:text-blue-light group-hover:text-red dark:group-hover:text-red-light transition-colors duration-200">{p.client}</p>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    </main>

    {/* Decorative bottom wave */}
    <div class="absolute bottom-0 left-0 right-0 overflow-hidden z-0" aria-hidden="true">
        <svg class="relative block w-full h-12 sm:h-16 md:h-20" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path
                d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C57.1,118.92,156.63,69.08,321.39,56.44Z"
                class="fill-blue-dark dark:fill-gray-dark"
            />
        </svg>
    </div>
</div>

{/* Highlight the desktop nav link matching the current path (React-free
    replacement for the old isCurrentPage state). No-op on "/" itself. */}
<script>
    function markActiveNav() {
        const path = window.location.pathname;
        document.querySelectorAll('header nav a[data-nav-link]').forEach((link) => {
            const href = link.getAttribute('href') || '';
            const active = href === '/' ? path === '/' : path.startsWith(href);
            if (active) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
        });
    }

    document.addEventListener('astro:page-load', markActiveNav);
</script>
