---
import {Image} from 'astro:assets';
import {type GenericPostType} from "../content.config.ts";
import {images} from './Images'
type Props = GenericPostType
const {collection, slug, title, description, image} = Astro.props
const link = `/${collection}/${slug}/`
---
<div class="flex flex-col rounded-lg shadow-lg dark:shadow-none dark:ring-1 dark:ring-white/10 overflow-hidden" id={slug} >
    <div class="flex-shrink-0 bg-gray-light dark:bg-white/5 hover:bg-red-light dark:hover:bg-white/10">
        <a href={link}>
            {/* A fixed 16:9 frame. Without it an image of any other shape spilled over the
                text below. object-cover fills the frame without distorting the picture. */}
            <div class="aspect-video w-full overflow-hidden">
                <Image
                        class="h-full w-full object-cover"
                        src={images[`/src${image}`]()}
                        alt={title}
                />
            </div>
        </a>
    </div>
    <div class="flex-1 bg-white dark:bg-white/5 p-6 flex flex-col justify-between hover:bg-red-light dark:hover:bg-white/10">
        <div class="flex-1">
            <a href={link} class="block mt-2">
                <p class="text-xl font-semibold text-red dark:text-red-light">{title}</p>
                <p class="mt-3 text-base text-gray-dark dark:text-blue-light">{description}</p>
            </a>
        </div>
    </div>
</div>

