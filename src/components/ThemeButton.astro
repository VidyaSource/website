---
interface Props {
    sunFillColor: string
    moonFillColor: string
}

const {sunFillColor, moonFillColor} = Astro.props
---
<button type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="false">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 ml-10" viewBox="0 0 20 20">
        <path fill-rule="evenodd"
              class="sun"
              d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
              clip-rule="evenodd"/>
        <path class="moon" d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
    </svg>
</button>

<style define:vars={{sunFillColor, moonFillColor}}>
    [data-theme-toggle] {
        border: 0;
        background: none;
    }

    /* Light-mode state first: it is also the fallback where light-dark() is unsupported. */
    .moon {
        fill: var(--moonFillColor);
    }

    .sun {
        fill: transparent;
    }

    /* light-dark() follows the color-scheme the root computes from the meta tag and the
       system setting (globals.css), so the icons swap with no JavaScript. */
    @supports (color: light-dark(white, black)) {
        .moon {
            fill: light-dark(var(--moonFillColor), transparent);
        }

        .sun {
            fill: light-dark(transparent, var(--sunFillColor));
        }
    }
</style>

{/* Bundled, not inline: the Content-Security-Policy allows no inline scripts. CSS alone
    follows the system setting. This script only handles a visitor's explicit choice and
    keeps the button state in step. The first-paint copy of a stored choice is in
    public/theme-init.js. */}
<script>
    type Theme = 'light' | 'dark';

    const systemQuery = window.matchMedia('(prefers-color-scheme: dark)');

    const readStored = (): Theme | null => {
        try {
            const stored = localStorage.getItem('theme');
            return stored === 'light' || stored === 'dark' ? stored : null;
        } catch {
            return null;
        }
    };

    // The scheme the visitor sees now: a stored choice, else the system setting.
    const rendered = (): Theme => readStored() ?? (systemQuery.matches ? 'dark' : 'light');

    // Put the choice in the meta tag (CSS reads it) and the state on every button.
    const sync = (choice: Theme | null = readStored()) => {
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (meta instanceof HTMLMetaElement) {
            meta.content = choice ?? 'light dark';
        }
        const dark = (choice ?? (systemQuery.matches ? 'dark' : 'light')) === 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.setAttribute('aria-pressed', String(dark));
        });
    };

    document.addEventListener('astro:page-load', () => {
        sync();

        const w = window as Window & { __themeToggleDelegated?: boolean };
        if (w.__themeToggleDelegated) {
            return;
        }
        w.__themeToggleDelegated = true;

        // Delegated so buttons mounted later also work (for example in the mobile popover).
        document.addEventListener('click', (e) => {
            const target = e.target;
            if (target instanceof Element && target.closest('[data-theme-toggle]')) {
                // The target is the opposite of what the visitor sees now.
                const next: Theme = rendered() === 'dark' ? 'light' : 'dark';
                const system: Theme = systemQuery.matches ? 'dark' : 'light';
                // Store only a choice that differs from the system. A choice that matches it
                // undoes the override, so the site follows the system again.
                const choice = next === system ? null : next;
                try {
                    if (choice === null) {
                        localStorage.removeItem('theme');
                    } else {
                        localStorage.setItem('theme', choice);
                    }
                } catch {
                    // Storage is blocked: the choice lasts for this page view only.
                }
                sync(choice);
            }
        }, { passive: true });

        // The system setting changed. CSS already follows it; refresh the button state.
        systemQuery.addEventListener('change', () => sync());

        // Another tab changed the choice.
        window.addEventListener('storage', (e) => {
            if (e.key === 'theme' || e.key === null) {
                sync();
            }
        });
    });

    // After a client-side navigation the swapped-in document may carry a fresh button.
    document.addEventListener('astro:after-swap', () => sync());
</script>
